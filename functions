void enviarWhatsApp(String message) {
  String url = "https://api.callmebot.com/whatsapp.php?phone=" 
               + phoneNumber 
               + "&apikey=" + apiKey 
               + "&text=" + urlEncode(message);

  HTTPClient http;
  http.begin(url);

  int httpResponseCode = http.GET();

  if (httpResponseCode == 200) {
    Serial.println("✅ Mensagem enviada com sucesso!");
  } else {
    Serial.print("❌ Erro: HTTP ");
    Serial.println(httpResponseCode);
  }

  http.end();
}

void enviarDados(float temperatura, float umidade) {
  HTTPClient http;
  http.begin(supabase_url);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("apikey", api_key);
  http.addHeader("Authorization", String("Bearer ") + api_key);

  StaticJsonDocument<256> doc;
  doc["temperatura_c"]      = temperatura;
  doc["umidade_pct"]        = umidade;
  doc["luminosidade"]       = valorLdrAtual;
  doc["presenca"]           = presencaDetectada;
  doc["probabilidade_vida"] = probabilidadeVida;

  String jsonBody;
  serializeJson(doc, jsonBody);

  int httpCode = http.POST(jsonBody);

  if (httpCode == 201) {
    Serial.println("Dados enviados com sucesso!");
  } else {
    Serial.printf("Erro %d: %s\n", httpCode, http.getString().c_str());
  }

  http.end();
}

void botao(){
  static bool estadoBotao = true;
  static bool estadoBotaoAnterior = true;
  const unsigned long debounce = 20;
  static unsigned long tempoDebounce = 0;
  if(millis() - tempoDebounce >= debounce){
    tempoDebounce = millis();
    estadoBotao = digitalRead(BOTAO);
    if(estadoBotao == LOW && estadoBotaoAnterior == HIGH){
      estadoSistema = !estadoSistema;
    }
    estadoBotaoAnterior = estadoBotao;
  }
}

