void calibrarLdr(bool &ldrCalibrado){
  static bool calibrado = false;
  static bool mensagemLdr = true;
  if(!ldrCalibrado){
    calibrado = false;
    if(mensagemLdr){
      Serial.print("CalibrandoLDR");
      mensagemLdr = false;
    }

    long soma = 0;
    for(int i = 0; i < 100; i++){
      soma += analogRead(LDR);
    }
    mediaLdr = soma/100;
    ldrCalibrado = true;
  }
  else if(!calibrado){
    Serial.println("LDR Calibrado");
    calibrado = true;
    mensagemLdr = true;
  }
}
void calcularProbabilidadeVida(float temperatura, float umidade) {
  int probabilidade = 0;

  if (temperatura >= 15.0 && temperatura <= 30.0)
    probabilidade += 25;

  if (umidade >= 40.0 && umidade <= 70.0)
    probabilidade += 25;

  if (valorLdrAtual > 2000)
    probabilidade += 20;

  if (presencaDetectada)
    probabilidade += 30;

  probabilidadeVida = probabilidade;
}

void alertaVida() {
  static bool alertaEnviado = false;

  if (probabilidadeVida > 75) {
    if (!alertaEnviado) {
      enviarWhatsApp("Alerta! Alta probabilidade de vida detectada no planeta.");
      alertaEnviado = true;
    }
  } else {
    alertaEnviado = false;
  }
}
