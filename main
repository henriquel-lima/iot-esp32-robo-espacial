#include <WiFi.h>
#include <HTTPClient.h>
#include <UrlEncode.h> 

const char* ssid = "Wokwi-GUEST";
const char* password = "";

String phoneNumber = "PHONE_NUMBER";
String apiKey = "API_KEY";

#define BOTAO 4
#define LED_VERDE 9
#define LED_VERMELHO 10
#define VRx 39
#define VRy 40

bool estadoSistema = true;
bool enviarMensagem = true;

bool estadoBotao = true;
bool estadoBotaoAnterior = true;
unsigned long tempoDebounce = 0;
const unsigned long debounce = 20;

uint16_t valorX;
uint16_t valorY;

void sendMessage(String message) {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;

    String url = "https://api.callmebot.com/whatsapp.php"
                 "?phone=" + phoneNumber +
                 "&text="  + urlEncode(message) +
                 "&apikey=" + apiKey;

    http.begin(url);
    int httpCode = http.GET();

    if (httpCode == 200) {
      Serial.println("Mensagem enviada!");
    } 
    else {
      Serial.println("Erro: " + String(httpCode));
    }

    http.end();
  }
}

void setup() {
  Serial.begin(115200);

  WiFi.begin(ssid, password);
  Serial.print("Conectando ao WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nConectado!");
  sendMessage("ESP32 online!");

  pinMode(BOTAO, INPUT_PULLUP);
  pinMode(LED_VERDE, OUTPUT);
  pinMode(LED_VERMELHO, OUTPUT);
}

void loop() {
  valorX = analogRead(VRx);
  valorY = analogRead(VRy);

  if(millis() - tempoDebounce >= debounce){
    tempoDebounce = millis();
    estadoBotao = digitalRead(BOTAO);
    if(estadoBotao == LOW && estadoBotaoAnterior == HIGH){
      estadoSistema = !estadoSistema;
    }
    estadoBotaoAnterior = estadoBotao;
  }

  if(estadoSistema){
    enviarMensagem = true;

    digitalWrite(LED_VERDE, HIGH);
    digitalWrite(LED_VERMELHO, LOW);

    if(valorX < 1000){
      Serial.print("Comando: ");
      Serial.println("ESQUERDA");
    }
    else if(valorX > 3000){
      Serial.print("Comando: ");
      Serial.println("Direita");
    }
    if(valorY < 1000){
      Serial.print("Comando: ");
      Serial.println("Frente");
    }
    else if(valorY > 3000){
      Serial.print("Comando: ");
      Serial.println("Trás");
    }
  }
  else{
    if(enviarMensagem){
      Serial.print("Comando: Desligar");
      sendMessage("Comando: Desligar");
      enviarMensagem = false;
    }
    digitalWrite(LED_VERDE, LOW);
    digitalWrite(LED_VERMELHO, HIGH);
  }
}
